{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dotnet",
			"task": "build",
			"group": "build",
			"problemMatcher": "$msCompile",
			"label": "build"
		},
		{
			"label": "watch example",
			"command": "dotnet",
			"type": "process",
			"problemMatcher": [],
			"args": [
				"watch",
				"--project",
				"${workspaceFolder}/TextureSetConverter/TextureSetConverter.csproj",
            ],
		},
		{
			"label": "build macOS release",
			"command": "${workspaceFolder}/build-macos.sh",
			"args": ["${input:macosArch}"],
			"type": "shell",
			"group": "build",
			"problemMatcher": "$msCompile",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	],
	"inputs": [
		{
			"id": "macosArch",
			"type": "pickString",
			"description": "macOS architecture to build for",
			"options": ["arm64", "x64", "both"],
			"default": "arm64"
		}
	]
}